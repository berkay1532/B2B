# "mock" (default, in-memory math pool) or "soroban" (real deployed Orbital AMM contract)
NEXT_PUBLIC_POOL_BACKEND=mock
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
# Required when NEXT_PUBLIC_POOL_BACKEND=soroban — the deployed pool contract's C... address.
NEXT_PUBLIC_POOL_CONTRACT_ID=
# "v1" (default) or "v2" — which Orbital math the *mock* pool runs. v2 is the
# paper's torus consolidation (boundary ticks keep trading). Mock-only: the
# deployed contract is v1, so a soroban-backed pool ignores this.
NEXT_PUBLIC_ORBITAL_MODE=v1
